# Kamal secrets template.
#
#   cp .kamal/secrets.example .kamal/secrets
#
# Then replace every CHANGE_ME. .kamal/secrets is gitignored — never commit it.
#
# Generate values ONCE and keep them stable across deploys:
#   SECRET_KEY_BASE:      openssl rand -base64 48
#   TOTP_VAULT_KEY:       openssl rand -base64 32
#   POSTGRES_PASSWORD:    openssl rand -hex 24
#   CLICKHOUSE_PASSWORD:  openssl rand -hex 24
# (hex keeps the passwords URL-safe for the connection URLs below)

SECRET_KEY_BASE=CHANGE_ME
TOTP_VAULT_KEY=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME
CLICKHOUSE_PASSWORD=CHANGE_ME

# Connection URLs the app consumes. Hostnames are the Kamal accessory
# container names (<service>-<accessory>) on the kamal Docker network.
DATABASE_URL=postgres://plausible:$POSTGRES_PASSWORD@plausible-db:5432/plausible_db
CLICKHOUSE_DATABASE_URL=http://plausible:$CLICKHOUSE_PASSWORD@plausible-events-db:8123/plausible_events_db

# Optional (uncomment and add to env.secret in config/deploy.yml):
# SMTP_USER_PWD=
# MAXMIND_LICENSE_KEY=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
